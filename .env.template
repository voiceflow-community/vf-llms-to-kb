# Copy this file to .env and fill in your values

# Voiceflow Knowledge Base API Key
API_KEY=

# URL to your llms.txt
LLMS_URL=

# Voiceflow domain (default: voiceflow.com)
DOMAIN=voiceflow.com

# Port for API server (default: 3000)
PORT=3000

# Optional: SQLite DB path (for Docker/cloud, use /app/vfllms.db or another writable location)
# SQLITE_PATH=/app/vfllms.db
